{
  "name": "toml-rs-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "deno run -A npm:vite",
    "build": "deno run -A npm:vite build",
    "preview": "deno run -A npm:vite preview",
    "lint": "oxlint --type-aware src tests scripts",
    "typecheck": "deno run -A scripts/vue-typecheck.ts -p tsconfig.json --noEmit",
    "knip": "knip",
    "test:a11y": "playwright test",
    "fmt": "oxfmt --write"
  },
  "dependencies": {
    "@fontsource/fira-code": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@jsonjoy.com/base64": "^18.30.0",
    "@speed-highlight/core": "^2.1.0",
    "fast-escape-html": "^1.1.0",
    "fflate": "^0.8.3",
    "torph": "^0.1.3",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@typescript/typescript6": "^6.0.2",
    "@vitejs/plugin-vue": "6.0.9",
    "knip": "^6.37.0",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-checker": "^0.14.5",
    "vue-tsc": "^3.3.11"
  }
}
