{
  "name": "toml-rs-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --bun vite",
    "build": "bun run --bun vite build",
    "preview": "bun run --bun vite preview",
    "lint": "oxlint --type-aware src tests scripts",
    "typecheck": "node scripts/vue-typecheck.ts -p tsconfig.json --noEmit",
    "knip": "knip",
    "test:a11y": "playwright test",
    "fmt": "oxfmt --write src tests scripts index.html package.json tsconfig.json knip.json playwright.config.ts vite.config.ts"
  },
  "dependencies": {
    "@fontsource/fira-code": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@jsonjoy.com/base64": "^18.30.0",
    "@speed-highlight/core": "^2.1.0",
    "fast-escape-html": "^1.1.0",
    "fflate": "^0.8.3",
    "torph": "^0.1.3",
    "vue": "3.5.42"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.10.1",
    "@typescript/typescript6": "^6.0.2",
    "@vitejs/plugin-vue": "6.0.8",
    "knip": "^6.35.1",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-checker": "^0.14.5",
    "vue-tsc": "^3.3.11"
  }
}
